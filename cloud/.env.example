# Fresh values must be entered by the owner in a supported secure Sites setup flow.
# Never copy the Mac session or put credentials in chat, source, D1, or tool arguments.
CELLARTRACKER_READS_ENABLED=false
CELLARTRACKER_WRITES_ENABLED=false
CELLARTRACKER_OWNER_USER_ID=
CELLARTRACKER_EXPECTED_ACCOUNT_ID=
CELLARTRACKER_ACCESS_MODE=timed
# ongoing requires explicit owner approval; timed requires the cutoff below.
CELLARTRACKER_SESSION_EXPIRES_AT=
CELLARTRACKER_SESSION_JSON=
# Optional hosted SECRET: paste only the raw Cookie request-header value in native Sites Settings.
# Leave this key absent to use the legacy JSON cookie. An explicitly blank value blocks requests.
# CELLARTRACKER_COOKIE=
